{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "plan": { "type": "string", "enum": ["free", "pro", "business"] },
        "documentsUsed": { "type": "integer" },
        "billingPeriodStart": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "plan", "documentsUsed", "billingPeriodStart"]
    },
    "Analysis": {
      "title": "Analysis",
      "description": "Document analysis result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "integer" },
        "analysis": { "type": "object" },
        "chunks": { "type": "array", "items": { "type": "object" } },
        "uploadDate": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["id", "fileName", "fileSize", "analysis", "uploadDate", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "Document analyses"
    }
  }
}
