rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global function to determine if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the current user owns the target userId profile
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // MVP validation: check basic required fields and structural integrity.
    // We intentionally leave plan/usageCount writable for MVP compatibility.
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'plan', 'usageCount']) &&
             data.plan in ['free', 'pro', 'business', 'true_docura'];
    }

    // User Profiles Security
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      // Allow creation when user first signs up (Frontend creates this right now)
      allow create: if isOwner(userId) 
                    && isValidUser(request.resource.data) 
                    && request.resource.data.id == userId;
                    
      // Allow generic updates (plan upgrades, usage increments)
      // BUT strictly lock down identity fields
      allow update: if isOwner(userId) 
                    && isValidUser(request.resource.data) 
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.id == resource.data.id;
                    
      allow delete: if isOwner(userId); // Users can delete their profile during account deletion
    }

    // Retained Identities Security
    match /retained_identities/{userId} {
      allow create: if isOwner(userId)
                    && request.resource.data.originalUserId == userId
                    && request.resource.data.status == 'deleted';
      allow read, update, delete: if false;
    }

    // Analyses Security
    match /analyses/{analysisId} {
      // READ: Only read your own analysis
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // CREATE: Must assign yourself as the owner
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'documentType', 'title']);
      
      // UPDATE: Prevent transferring ownership to someone else
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
                    
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Nested Collection Security: Chunks 
      match /chunks/{chunkId} {
        function isParentOwner() {
          let parentDoc = get(/databases/$(database)/documents/analyses/$(analysisId));
          // Provide safety check if document doesn't exist
          return parentDoc != null && parentDoc.data.userId == request.auth.uid;
        }

        allow read, create, update, delete: if isAuthenticated() && isParentOwner();
      }
    }
  }
}
